@* Outline icons drawn on a 24px grid in the current text color. Decorative only: the control that
   holds an icon always has a visible label or an aria-label. *@
<svg class="zl-icon @Class" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="@StrokeWidth" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case IconName.ArrowDown:
            <path d="M12 5v14M6 13l6 6 6-6" />
            break;
        case IconName.ArrowLeft:
            <path d="M19 12H5M11 6l-6 6 6 6" />
            break;
        case IconName.ArrowUp:
            <path d="M12 19V5M6 11l6-6 6 6" />
            break;
        case IconName.CheckCircle:
            <circle cx="12" cy="12" r="9" />
            <path d="M8 12.5l2.5 2.5L16 9.5" />
            break;
        case IconName.Close:
            <path d="M6 6l12 12M18 6L6 18" />
            break;
        case IconName.Compass:
            <circle cx="12" cy="12" r="9" />
            <path d="M15.5 8.5l-2 5-5 2 2-5z" />
            break;
        case IconName.ErrorCircle:
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7.5v5.5M12 16.5h.01" />
            break;
        case IconName.Info:
            <circle cx="12" cy="12" r="9" />
            <path d="M12 11v5.5M12 7.5h.01" />
            break;
        case IconName.Menu:
            <path d="M4 7h16M4 12h16M4 17h16" />
            break;
        case IconName.Plus:
            <path d="M12 5v14M5 12h14" />
            break;
        case IconName.Refresh:
            <path d="M20 11a8 8 0 0 0-14.3-4.9L4 8" />
            <path d="M4 4v4h4" />
            <path d="M4 13a8 8 0 0 0 14.3 4.9L20 16" />
            <path d="M20 20v-4h-4" />
            break;
        case IconName.SortNeutral:
            <path d="M8 9l4-4 4 4M8 15l4 4 4-4" />
            break;
        case IconName.Star:
            <path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z" />
            break;
        case IconName.Users:
            <circle cx="10" cy="7.5" r="3.5" />
            <path d="M3.5 19.5v-1A4.5 4.5 0 0 1 8 14h4a4.5 4.5 0 0 1 4.5 4.5v1" />
            <path d="M15.5 4.2a3.5 3.5 0 0 1 0 6.6" />
            <path d="M18.5 14.3a4.5 4.5 0 0 1 2 3.7v1.5" />
            break;
        case IconName.Warning:
            <path d="M10.3 4.3L2.6 17.6a2 2 0 0 0 1.7 3h15.4a2 2 0 0 0 1.7-3L13.7 4.3a2 2 0 0 0-3.4 0z" />
            <path d="M12 9.5v4M12 17h.01" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired]
    public IconName Name { get; set; }

    [Parameter]
    public int Size { get; set; } = 20;

    // A string so the SVG attribute is culture-invariant ("1.75", never "1,75").
    [Parameter]
    public string StrokeWidth { get; set; } = "1.75";

    [Parameter]
    public string? Class { get; set; }
}