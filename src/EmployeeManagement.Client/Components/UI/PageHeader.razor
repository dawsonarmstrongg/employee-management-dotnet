@* Standard page header: optional overline, the page title (h1), a short description, metadata such as
   "last updated", and the page's actions (at most one primary button). *@
<header class="zl-page-header">
    <div class="zl-page-header__text">
        @if (Overline is not null)
        {
            <p class="zl-overline">@Overline</p>
        }
        <h1 class="zl-page-title" tabindex="-1">@Title</h1>
        @if (Description is not null)
        {
            <p class="zl-page-description">@Description</p>
        }
        @if (Meta is not null)
        {
            <div class="zl-page-meta">@Meta</div>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="zl-page-header__actions">@Actions</div>
    }
</header>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    [Parameter]
    public string? Overline { get; set; }

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public RenderFragment? Meta { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }
}