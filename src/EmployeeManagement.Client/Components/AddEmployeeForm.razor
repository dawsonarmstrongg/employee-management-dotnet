@using System.Globalization
@implements IAsyncDisposable
@inject EmployeeApiClient Api
@inject IJSRuntime JS
@* The add-employee form shown in the drawer. Browser validation is off (novalidate) so every message
   comes from the shared validator and appears next to its field in the same style. *@

<EditForm EditContext="editContext" OnValidSubmit="SaveAsync" OnInvalidSubmit="HandleInvalidSubmit"
          class="zl-drawer__form" novalidate Context="formContext">
    <EmployeeFormValidator @ref="validator" />

    <div @ref="body" class="zl-drawer__body">
        @if (errorMessage is not null)
        {
            <div @ref="errorSummary" class="zl-form-error" tabindex="-1">
                <Alert Tone="Tone.Error" Title="The employee wasn't saved">@errorMessage</Alert>
            </div>
        }

        <p class="zl-form-note">Required fields are marked with an asterisk (*).</p>

        <fieldset class="zl-form-section">
            <legend class="zl-form-section__title">Personal details</legend>
            <div class="zl-form-grid">
                <FormField Id="firstName" Label="First name" Required="true" For="() => request.FirstName">
                    <InputText id="firstName" class="form-control" autofocus aria-required="true"
                               aria-describedby="@context.DescribedBy" @bind-Value="request.FirstName" />
                </FormField>
                <FormField Id="lastName" Label="Last name" Required="true" For="() => request.LastName">
                    <InputText id="lastName" class="form-control" aria-required="true"
                               aria-describedby="@context.DescribedBy" @bind-Value="request.LastName" />
                </FormField>
                <FormField Id="dateOfBirth" Label="Date of birth" Required="true" For="() => request.DateOfBirth">
                    <InputDate id="dateOfBirth" class="form-control" min="1900-01-01" max="@today" aria-required="true"
                               aria-describedby="@context.DescribedBy" @bind-Value="request.DateOfBirth" />
                </FormField>
            </div>
        </fieldset>

        <fieldset class="zl-form-section">
            <legend class="zl-form-section__title">Contact</legend>
            <div class="zl-form-grid">
                <FormField Id="email" Label="Email" Required="true" For="() => request.Email">
                    <InputText id="email" type="email" class="form-control" aria-required="true"
                               aria-describedby="@context.DescribedBy" @bind-Value="request.Email" />
                </FormField>
                <FormField Id="phone" Label="Phone" Required="true" Help="Type 10 digits; formatting is added as you type."
                           For="() => request.PhoneNumber">
                    <InputPhoneNumber id="phone" class="form-control" placeholder="(555)-123-4567" aria-required="true"
                                      aria-describedby="@context.DescribedBy" @bind-Value="request.PhoneNumber" />
                </FormField>
            </div>
        </fieldset>

        <fieldset class="zl-form-section">
            <legend class="zl-form-section__title">Address</legend>
            <div class="zl-form-grid">
                <FormField Id="address1" Label="Address 1" Required="true" Class="zl-span-full" For="() => request.Address!.Address1">
                    <InputText id="address1" class="form-control" aria-required="true"
                               aria-describedby="@context.DescribedBy" @bind-Value="request.Address!.Address1" />
                </FormField>
                <FormField Id="address2" Label="Address 2" Optional="true" Class="zl-span-full" For="() => request.Address!.Address2">
                    <InputText id="address2" class="form-control"
                               aria-describedby="@context.DescribedBy" @bind-Value="request.Address!.Address2" />
                </FormField>
                <div class="zl-form-grid zl-form-grid--city-state-zip zl-span-full">
                    <FormField Id="city" Label="City" Required="true" For="() => request.Address!.City">
                        <InputText id="city" class="form-control" aria-required="true"
                                   aria-describedby="@context.DescribedBy" @bind-Value="request.Address!.City" />
                    </FormField>
                    <FormField Id="state" Label="State" Required="true" Help="Type to filter, e.g. TX" For="() => request.Address!.State">
                        <InputUsState id="state" class="form-control" placeholder="TX" aria-required="true"
                                      aria-describedby="@context.DescribedBy" @bind-Value="request.Address!.State" />
                    </FormField>
                    <FormField Id="zip" Label="Zip" Required="true" For="() => request.Address!.Zip">
                        <InputText id="zip" class="form-control" maxlength="5" inputmode="numeric" placeholder="12345"
                                   aria-required="true" aria-describedby="@context.DescribedBy" @bind-Value="request.Address!.Zip" />
                    </FormField>
                </div>
            </div>
        </fieldset>
    </div>

    <div class="zl-drawer__footer">
        <button type="button" class="btn btn-secondary" disabled="@saving" @onclick="OnCancel">Cancel</button>
        <button type="submit" class="btn btn-primary" disabled="@saving">
            @if (saving)
            {
                <span class="zl-spinner zl-spinner--sm" aria-hidden="true"></span>
                <span>Saving…</span>
            }
            else
            {
                <span>Add employee</span>
            }
        </button>
    </div>
</EditForm>

@code {
    private readonly EmployeeRequest request = new();
    private EditContext editContext = default!;
    private EmployeeFormValidator? validator;
    private ElementReference body;
    private ElementReference errorSummary;
    private IJSObjectReference? module;
    private string today = "";
    private bool saving;
    private string? errorMessage;
    private bool focusInvalidPending;
    private bool focusErrorPending;

    // Raised after the API creates the employee, so the page can add it to the table.
    [Parameter]
    public EventCallback<EmployeeDto> OnCreated { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    public bool IsSaving => saving;

    // True once anything has been entered, so closing the drawer can ask before discarding it.
    public bool HasChanges =>
        HasText(request.FirstName) || HasText(request.LastName) || HasText(request.Email)
        || HasText(request.PhoneNumber) || request.DateOfBirth is not null
        || request.Address is { } address
            && (HasText(address.Address1) || HasText(address.Address2) || HasText(address.City)
                || HasText(address.State) || HasText(address.Zip));

    protected override void OnInitialized()
    {
        editContext = new EditContext(request);
        today = DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    }

    // After a failed submit, move focus to the first field with an error (or to the server error),
    // so keyboard and screen reader users land on what needs fixing.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusErrorPending)
        {
            focusErrorPending = false;
            await errorSummary.FocusAsync();
        }
        else if (focusInvalidPending)
        {
            focusInvalidPending = false;
            module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/AddEmployeeForm.razor.js");
            await module.InvokeVoidAsync("focusFirstInvalid", body);
        }
    }

    private void HandleInvalidSubmit() => focusInvalidPending = true;

    private async Task SaveAsync()
    {
        saving = true;
        errorMessage = null;

        try
        {
            var result = await Api.CreateAsync(request);
            if (result.Employee is not null)
            {
                await OnCreated.InvokeAsync(result.Employee);
            }
            else if (result.Errors is not null)
            {
                validator!.DisplayErrors(result.Errors);
                focusInvalidPending = true;
            }
            else
            {
                errorMessage = result.ErrorMessage;
                focusErrorPending = true;
            }
        }
        catch (HttpRequestException)
        {
            errorMessage = "Could not reach the server. Check that it is running and try again.";
            focusErrorPending = true;
        }
        finally
        {
            saving = false;
        }
    }

    private static bool HasText(string? value) => !string.IsNullOrWhiteSpace(value);

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            try
            {
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The page is unloading; nothing to clean up.
            }
        }
    }
}