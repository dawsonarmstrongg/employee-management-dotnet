@* Sortable employee list. Wide content scrolls sideways inside the card on small screens, so the region
   is focusable for keyboard scrolling and named by the table caption. *@
<div class="zl-table-scroll" tabindex="0" role="region" aria-labelledby="employee-table-caption">
    <table class="zl-table">
        <caption id="employee-table-caption" class="visually-hidden">@Caption</caption>
        <thead>
            <tr>
                <SortableHeader Column="EmployeeSortColumn.Name" Label="Name" Sort="sort" OnSort="ChangeSort" />
                <SortableHeader Column="EmployeeSortColumn.Email" Label="Email" Sort="sort" OnSort="ChangeSort" />
                <th scope="col">Phone</th>
                <SortableHeader Column="EmployeeSortColumn.DateOfBirth" Label="Date of birth" Sort="sort" OnSort="ChangeSort" />
                <th scope="col">Address</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var employee in sorted)
            {
                <tr @key="employee.Id">
                    <td>
                        <span class="zl-cell-name">
                            <span class="zl-cell-strong">@EmployeeDisplay.SortableName(employee)</span>
                            @if (NewIds.Contains(employee.Id))
                            {
                                <StatusChip Text="New" Tone="Tone.Attention" />
                            }
                        </span>
                    </td>
                    <td><a href="mailto:@employee.Email">@employee.Email</a></td>
                    <td class="zl-tabular zl-nowrap">@employee.PhoneNumber</td>
                    <td class="zl-tabular zl-nowrap">@EmployeeDisplay.DateOfBirth(employee.DateOfBirth)</td>
                    <td>@EmployeeDisplay.FullAddress(employee.Address)</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<p class="visually-hidden" role="status">@sortAnnouncement</p>

@code {
    private EmployeeSort sort = EmployeeSort.Default;
    private List<EmployeeDto> sorted = [];
    private string sortAnnouncement = "";

    [Parameter, EditorRequired]
    public IReadOnlyList<EmployeeDto> Employees { get; set; } = [];

    // Employees added in this session; marked "New" so they're easy to find in the sorted list.
    [Parameter]
    public IReadOnlySet<int> NewIds { get; set; } = new HashSet<int>();

    private string Caption => $"Employees, sorted by {ColumnName(sort.Column)}, {DirectionName(sort.Direction)}";

    protected override void OnParametersSet() => sorted = EmployeeSorter.Sort(Employees, sort);

    private void ChangeSort(EmployeeSortColumn column)
    {
        sort = sort.Toggle(column);
        sorted = EmployeeSorter.Sort(Employees, sort);
        sortAnnouncement = $"Sorted by {ColumnName(sort.Column)}, {DirectionName(sort.Direction)}";
    }

    private static string ColumnName(EmployeeSortColumn column) => column switch
    {
        EmployeeSortColumn.Email => "email",
        EmployeeSortColumn.DateOfBirth => "date of birth",
        _ => "last name",
    };

    private static string DirectionName(SortDirection direction) =>
        direction == SortDirection.Ascending ? "ascending" : "descending";
}