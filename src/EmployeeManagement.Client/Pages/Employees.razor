@page "/"
@using System.Globalization
@inject EmployeeApiClient Api
@inject ToastService Toasts

<PageTitle>Employees · Employee Management</PageTitle>

<PageHeader Title="Employees" Description="Review employee contact details and add new employees.">
    <Meta>
        @if (lastUpdated is { } updated)
        {
            <span>
                Updated
                <time datetime="@updated.ToString("O", CultureInfo.InvariantCulture)">@updated.ToString("h:mm tt", CultureInfo.InvariantCulture)</time>
            </span>
        }
        else
        {
            <span>@(loadFailed ? "Not loaded" : "Loading…")</span>
        }
    </Meta>
    <Actions>
        @* aria-disabled rather than disabled while refreshing, so keyboard focus stays on the button. *@
        <button type="button" class="btn btn-secondary" disabled="@(employees is null)"
                aria-disabled="@(refreshing ? "true" : null)" @onclick="RefreshAsync">
            @if (refreshing)
            {
                <span class="zl-spinner zl-spinner--sm" aria-hidden="true"></span>
                <span>Refreshing…</span>
            }
            else
            {
                <Icon Name="IconName.Refresh" />
                <span>Refresh</span>
            }
        </button>
        <button type="button" class="btn btn-primary" @onclick="OpenAddDrawer">
            <Icon Name="IconName.Plus" />
            <span>Add employee</span>
        </button>
    </Actions>
</PageHeader>

<section class="zl-card">
    <div class="zl-card__header">
        <h2 class="zl-card__title">
            All employees
            @if (employees is not null)
            {
                <span class="zl-count"><span class="visually-hidden">(</span>@employees.Count<span class="visually-hidden"> total)</span></span>
            }
        </h2>
    </div>

    @if (employees is null && loadFailed)
    {
        <EmptyState Icon="IconName.ErrorCircle" Tone="Tone.Error" Title="Couldn't load employees"
                    Message="Check that the server is running, then try again.">
            <button type="button" class="btn btn-secondary" @onclick="LoadAsync">
                <Icon Name="IconName.Refresh" />
                <span>Try again</span>
            </button>
        </EmptyState>
    }
    else if (employees is null)
    {
        <TableSkeleton Columns="SkeletonColumns" Label="Loading employees" />
    }
    else if (employees.Count == 0)
    {
        <EmptyState Icon="IconName.Users" Title="No employees yet" Message="Employees you add will appear here.">
            <button type="button" class="btn btn-secondary" @onclick="OpenAddDrawer">
                <Icon Name="IconName.Plus" />
                <span>Add employee</span>
            </button>
        </EmptyState>
    }
    else
    {
        <EmployeeTable Employees="employees" NewIds="newIds" />
    }
</section>

<Drawer Open="addOpen" Title="Add employee" Description="Enter the new employee's details."
        OnCloseRequested="RequestCloseAddDrawer">
    <AddEmployeeForm @ref="addForm" OnCreated="HandleCreatedAsync" OnCancel="RequestCloseAddDrawer" />
</Drawer>

<ConfirmDialog Open="confirmDiscardOpen" Title="Discard this employee?"
               Message="The details you entered haven't been saved. If you close the form now, they'll be lost."
               ConfirmText="Discard" CancelText="Keep editing" Destructive="true"
               OnConfirm="DiscardChanges" OnCancel="KeepEditing" OnClosed="HandleConfirmClosed" />

@code {
    private static readonly string[] SkeletonColumns = ["Name", "Email", "Phone", "Address"];

    private readonly HashSet<int> newIds = [];
    private List<EmployeeDto>? employees;
    private bool loadFailed;
    private bool refreshing;
    private DateTimeOffset? lastUpdated;
    private bool addOpen;
    private bool confirmDiscardOpen;
    private bool discardPending;
    private AddEmployeeForm? addForm;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        loadFailed = false;
        employees = null;
        try
        {
            employees = [.. await Api.GetAllAsync()];
            lastUpdated = DateTimeOffset.Now;
        }
        catch (HttpRequestException)
        {
            loadFailed = true;
        }
    }

    // Reloads in place: the current list stays visible, and a failure is reported without losing it.
    private async Task RefreshAsync()
    {
        if (refreshing)
        {
            return;
        }

        refreshing = true;
        try
        {
            employees = [.. await Api.GetAllAsync()];
            lastUpdated = DateTimeOffset.Now;
        }
        catch (HttpRequestException)
        {
            Toasts.Show(Tone.Error, "Couldn't refresh employees. Check that the server is running.");
        }
        finally
        {
            refreshing = false;
        }
    }

    private void OpenAddDrawer() => addOpen = true;

    // Escape, the backdrop, the X button and Cancel all come here. Unsaved input is confirmed first.
    private void RequestCloseAddDrawer()
    {
        if (addForm?.IsSaving == true)
        {
            return;
        }

        if (addForm?.HasChanges == true)
        {
            confirmDiscardOpen = true;
        }
        else
        {
            addOpen = false;
        }
    }

    // Close the confirmation first and the drawer after it, so focus returns to "Add employee".
    private void DiscardChanges()
    {
        discardPending = true;
        confirmDiscardOpen = false;
    }

    private void KeepEditing() => confirmDiscardOpen = false;

    private void HandleConfirmClosed()
    {
        if (discardPending)
        {
            discardPending = false;
            addOpen = false;
        }
    }

    // Add the new employee locally instead of reloading the list; the table keeps its sort order.
    private async Task HandleCreatedAsync(EmployeeDto employee)
    {
        addOpen = false;
        newIds.Add(employee.Id);
        Toasts.Show(Tone.Success, $"{EmployeeDisplay.FullName(employee)} was added.");

        if (employees is null)
        {
            await LoadAsync();
        }
        else
        {
            employees.Add(employee);
        }
    }
}