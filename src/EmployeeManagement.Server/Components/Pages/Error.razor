@page "/Error"
@using System.Diagnostics
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>Error · Employee Management</PageTitle>

<section class="zl-card">
    <EmptyState Icon="IconName.ErrorCircle" Tone="Tone.Error" HeadingLevel="1" Title="Something went wrong"
                Message="An error occurred while processing your request. Try again, or go back to the employee list.">
        <Details>
            @if (ShowRequestId)
            {
                <p>Reference ID: <span class="zl-mono">@RequestId</span></p>
            }
        </Details>
        <ChildContent>
            <a class="btn btn-primary" href="">
                <Icon Name="IconName.ArrowLeft" />
                <span>Back to employees</span>
            </a>
        </ChildContent>
    </EmptyState>
</section>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }

    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}